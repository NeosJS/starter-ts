{
  "name": "@neosjs/template",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@9.9.0",
  "description": "_description_",
  "author": "听着情歌流泪",
  "license": "MIT",
  "homepage": "https://docs.neosjs.com",
  "keywords": [
    "neosjs",
    "neos"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=8.10.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "prepublishOnly": "pnpm build",
    "release": "release && npm publish",
    "start": "esno src/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@neosjs/eslint-config": "latest",
    "@types/node": "^22.5.4",
    "eslint": "^9.9.0",
    "eslint-plugin-format": "^0.1.2",
    "esno": "^4.7.0",
    "lint-staged": "^15.2.10",
    "pnpm": "^9.9.0",
    "simple-git-hooks": "^2.11.1",
    "tsdown": "^0.22.5",
    "tsdown-stale-guard": "^0.1.3",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^2.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
